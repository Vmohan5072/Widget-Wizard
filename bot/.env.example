# Discord application (Developer Portal -> your app)
DISCORD_TOKEN=
APPLICATION_ID=

# Authorization URL handed out by /widget setup. Scope must be
# sdk.social_layer_presence with response_type=token:
# https://discord.com/oauth2/authorize?client_id=YOUR_APP_ID&scope=sdk.social_layer_presence&response_type=token
OAUTH_URL=

# Faceit Data API key (https://developers.faceit.com -> App Studio -> server-side key)
FACEIT_API_KEY=

# Leetify public API key (https://leetify.com/app/developer) - optional, raises rate limits
LEETIFY_API_KEY=

# Steam Web API key (https://steamcommunity.com/dev/apikey) - optional,
# only needed to resolve vanity URLs like steamcommunity.com/id/yourname
STEAM_API_KEY=

# Auto refresh interval in minutes. 0 disables.
REFRESH_MINUTES=60
